DATABASE_URL=mysql+pymysql://norus_app:CHANGE_ME@127.0.0.1:3306/norus?charset=utf8mb4
# Para MySQL en local o producción:
# DATABASE_URL=mysql+pymysql://usuario:password@127.0.0.1:3306/norus?charset=utf8mb4
NORUS_SECRET_KEY=generate-a-long-random-secret
NORUS_DOCUMENT_KEY=generate-a-url-safe-base64-32-byte-key
NORUS_COOKIE_SECURE=false
NORUS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
NORUS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
PUBLIC_APP_URL=http://127.0.0.1:8000

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_STARTTLS=true
PROPERTY_EMAIL_LAS_CONDES=
PROPERTY_EMAIL_PROVIDENCIA=
